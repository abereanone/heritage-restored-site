---
import { Image } from "astro:assets";
import { autoLinkBibleRefs } from "../utils/autoLinkBibleRefs.js";
import siteLogo from "../images/logo.webp";
import "../styles/global.css";

const siteName = "Heritage Restored";
const { title, description: propDescription, image: propImage } = Astro.props;

const baseDescription =
  "Heritage Restored equips Christians with theology, witness, and resources centered on love-driven abolition.";
const pageTitle = title ?? siteName;
// The <title> carries the site name so search results and tabs are identifiable;
// og:title omits it because og:site_name already supplies it.
const documentTitle = title ? `${title} | ${siteName}` : siteName;
const metaDescription = propDescription ?? baseDescription;
// 1200x630 so link previews render as a large card rather than a cropped square.
const baseImage = propImage ?? "/og-card.png";

const origin = Astro.url.origin ?? "";
const baseUrl = Astro.site ?? origin;
const canonicalHref = baseUrl ? new URL(Astro.url.pathname, baseUrl).href : Astro.url.href;
const metaImageUrl = baseUrl ? new URL(baseImage, baseUrl).href : baseImage;

const siteHref = baseUrl ? new URL("/", baseUrl).href : "/";
const logoHref = baseUrl ? new URL("/logo-512.png", baseUrl).href : "/logo-512.png";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  "@id": `${siteHref}#organization`,
  name: siteName,
  url: siteHref,
  logo: logoHref,
  image: logoHref,
  description: baseDescription,
  email: "heritagerestoredabolition@gmail.com",
  taxID: "39-3248627",
  nonprofitStatus: "Nonprofit501c3",
  areaServed: {
    "@type": "State",
    name: "Ohio",
  },
  sameAs: [
    "https://www.youtube.com/@HeritageRestored",
    "https://www.youtube.com/@HeritageRestoredStories",
    "https://www.instagram.com/restoredheritage/",
    "https://www.tiktok.com/@heritage_restored",
    "https://x.com/HeritageRestord",
  ],
};

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/resources", label: "Resources" },
  { href: "/people", label: "People" },
  { href: "/beliefs", label: "Beliefs" },
  { href: "/plm_abo_ai_compare", label: "Compare" },
  { href: "/aiivf", label: "IVF" },
  { href: "/contact", label: "Contact" },
  { href: "/donate", label: "Donate" },
];
// Trailing slashes are stripped so /people and /people/ both match.
const currentPath = "/" + Astro.url.pathname.replace(/^\/+|\/+$/g, "");

// Capture all slot content and auto-link Bible refs
const raw = Astro.slots.default ? await Astro.slots.render("default") : "";
const processed = autoLinkBibleRefs(raw);
---

<html lang="en" class="theme-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{documentTitle}</title>
    {/* Must run before first paint, or dark-mode visitors get a white flash. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (prefersDark ? "dark" : "light");
          if (theme === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch (e) {
          /* localStorage unavailable (private mode); fall through to light. */
        }
      })();
    </script>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={metaImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} logo`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <!-- Safe Google Analytics Loader (handles blockers and failures) -->
    <script>
      (function () {
        function initAnalytics() {
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          window.gtag = gtag;

          gtag("js", new Date());
          gtag("config", "G-M5J5WYS3VJ");
        }

        function loadAnalytics() {
          var script = document.createElement("script");
          script.src = "https://www.googletagmanager.com/gtag/js?id=G-M5J5WYS3VJ";
          script.async = true;

          script.onload = function () {
            initAnalytics();
          };

          script.onerror = function () {
            console.warn("Analytics blocked or failed to load.");
          };

          document.head.appendChild(script);
        }

        // Load it
        loadAnalytics();

        // Optional: detect if blocked after delay
        setTimeout(function () {
          if (!window.gtag) {
            console.log("Analytics likely blocked");
          }
        }, 2000);
      })();
    </script>

    <script>
      // Safe helper for tracking events
      function trackEvent(name, params) {
        if (window.gtag) {
          gtag("event", name, params || {});
        }
      }
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to main content</a>
    <header>
      <button id="theme-toggle" class="theme-toggle-button" type="button">Dark Mode</button>
      <div class="logo-container">
        <a href="/">
          <Image
            src={siteLogo}
            alt="Heritage Restored Logo"
            class="site-logo"
            width={380}
            loading="eager"
          />
        </a>
      </div>
      <nav aria-label="Main">
        <div>
          {
            navLinks.map((link) => (
              <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </div>
        <div class="social">
          <a href="https://www.youtube.com/@HeritageRestored" target="_blank" aria-label="YouTube">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 576 512"
              fill="currentColor"
              width="20"
              height="20"
              ><path
                d="M549.7 124.1c-6.3-23.8-24.9-42.4-48.6-48.7C456.5 64 288 64 288 64s-168.5 0-213.1 11.4c-23.8 6.3-42.4 24.9-48.6 48.7C16 168.7 16 256 16 256s0 87.3 10.3 131.9c6.3 23.8 24.9 42.4 48.6 48.7C119.5 448 288 448 288 448s168.5 0 213.1-11.4c23.8-6.3 42.4-24.9 48.6-48.7C560 343.3 560 256 560 256s0-87.3-10.3-131.9zM232 336V176l142.7 80L232 336z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.instagram.com/restoredheritage/"
            target="_blank"
            aria-label="Instagram"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 448 512"
              fill="currentColor"
              width="20"
              height="20"
              ><path
                d="M224,202.66A53.34,53.34,0,1,0,277.34,256,53.38,53.38,0,0,0,224,202.66Zm124.71-41a54,54,0,0,0-30.18-30.18C296.09,122.24,256,120,224,120s-72.09,2.24-94.53,11.49a54,54,0,0,0-30.18,30.18C88.24,151.91,86,191.91,86,224s2.24,72.09,11.49,94.53a54,54,0,0,0,30.18,30.18C151.91,359.76,191.91,362,224,362s72.09-2.24,94.53-11.49a54,54,0,0,0,30.18-30.18C359.76,296.09,362,256,362,224S359.76,151.91,348.71,161.66ZM398.8,80.41A47.19,47.19,0,1,0,446,127.6,47.19,47.19,0,0,0,398.8,80.41ZM224,338.66A114.66,114.66,0,1,1,338.66,224,114.77,114.77,0,0,1,224,338.66Z"
              ></path></svg
            >
          </a>
          <a href="https://www.tiktok.com/@heritage_restored" target="_blank" aria-label="TikTok">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 448 512"
              fill="currentColor"
              width="20"
              height="20"
              ><path
                d="M448,209.3V129.8a127.2,127.2,0,0,1-75-23.7V285.5a136.43,136.43,0,1,1-136.5-136.5,134.21,134.21,0,0,1,16.7,1.1V103.6a178.59,178.59,0,0,0-16.7-.8C106.5,102.8,0,209.3,0,336S106.5,569.2,233.3,569.2,448,462.7,448,336Z"
              ></path></svg
            >
          </a>
          <a href="https://x.com/HeritageRestord" target="_blank" aria-label="X">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 512 512"
              fill="currentColor"
              width="20"
              height="20"
              ><path
                d="M370.6 36H449L304.1 217.5 475 476H338.6L234.4 322.3 112.1 476H33.1L188.5 284.2 23 36H163.3L257.7 175.4 370.6 36z"
              ></path></svg
            >
          </a>
        </div>
      </nav>
    </header>

    <main id="main">
      <!-- Processed content with auto-linked refs -->
      <div set:html={processed} />
    </main>

    <footer>
      <p>At Heritage Restored, all our work is dedicated to the public domain. EIN 39-3248627</p>
      <p>
        <a
          href="https://github.com/abereanone/heritage-restored-site/issues/new"
          target="_blank"
          rel="noopener noreferrer"
        >
          Report an Issue
        </a>
      </p>
    </footer>

    <script>
      // Theme toggle. The class is already set by the inline head script; this
      // only syncs the button label and persists an explicit choice.
      const toggleBtn = document.getElementById("theme-toggle");
      const root = document.documentElement;

      function syncLabel() {
        const isDark = root.classList.contains("dark-mode");
        toggleBtn.textContent = isDark ? "Light Mode" : "Dark Mode";
        toggleBtn.setAttribute("aria-pressed", String(isDark));
      }

      syncLabel();

      toggleBtn.addEventListener("click", () => {
        const nextTheme = root.classList.contains("dark-mode") ? "light" : "dark";
        root.classList.toggle("dark-mode", nextTheme === "dark");
        try {
          localStorage.setItem("theme", nextTheme);
        } catch (e) {
          /* ignore */
        }
        syncLabel();
      });

      // Follow the OS while the visitor has not made an explicit choice.
      if (window.matchMedia) {
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
          let stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch (e) {
            /* ignore */
          }
          if (stored) return;
          root.classList.toggle("dark-mode", event.matches);
          syncLabel();
        });
      }
    </script>

    <script>
      import { normalizeReference } from "../utils/normalizeRef.js";
      import { getVerseData } from "../utils/bibleClient.js";

      // Bible reference tooltips. Works with mouse, keyboard, and touch: refs are
      // exposed as buttons, open on hover/focus, and pin open on click/Enter/Space.
      let tooltip = null;
      let activeRef = null;
      let pinned = false;

      function ensureTooltip() {
        if (tooltip) return tooltip;
        tooltip = document.createElement("div");
        tooltip.className = "bible-tooltip";
        tooltip.id = "bible-tooltip";
        tooltip.setAttribute("role", "tooltip");
        document.body.appendChild(tooltip);
        return tooltip;
      }

      function positionTooltip(el) {
        const tip = ensureTooltip();
        const rect = el.getBoundingClientRect();

        tip.style.visibility = "hidden";
        tip.style.display = "block";
        const tipWidth = tip.offsetWidth;
        const tipHeight = tip.offsetHeight;
        tip.style.visibility = "visible";

        let left = rect.left + window.scrollX;
        const maxLeft = window.innerWidth - tipWidth - 10;
        if (left > maxLeft) left = maxLeft;
        if (left < 10) left = 10;

        // Flip above the reference when there is no room below.
        const spaceBelow = window.innerHeight - rect.bottom;
        const top =
          spaceBelow < tipHeight + 12
            ? rect.top + window.scrollY - tipHeight - 6
            : rect.bottom + window.scrollY + 6;

        tip.style.left = `${left}px`;
        tip.style.top = `${Math.max(top, window.scrollY + 4)}px`;
      }

      function hideTooltip() {
        if (!tooltip) return;
        tooltip.style.display = "none";
        if (activeRef) {
          activeRef.setAttribute("aria-expanded", "false");
          activeRef.removeAttribute("aria-describedby");
        }
        activeRef = null;
        pinned = false;
      }

      async function showTooltip(el) {
        const tip = ensureTooltip();

        if (activeRef && activeRef !== el) {
          activeRef.setAttribute("aria-expanded", "false");
          activeRef.removeAttribute("aria-describedby");
        }
        activeRef = el;

        if (!el.dataset.verseText) {
          try {
            const verse = await getVerseData(normalizeReference(el.dataset.ref));
            el.dataset.verseText = verse ? `${verse.text} (${verse.version})` : "Verse not found";
          } catch (err) {
            el.dataset.verseText = "Verse not found";
          }
          // A different ref may have been opened while this was resolving.
          if (activeRef !== el) return;
        }

        tip.textContent = el.dataset.verseText;
        el.setAttribute("aria-expanded", "true");
        el.setAttribute("aria-describedby", "bible-tooltip");
        positionTooltip(el);
      }

      function initBibleRefs() {
        document.querySelectorAll(".bible-ref").forEach((el) => {
          if (el.dataset.bibleRefReady) return;
          el.dataset.bibleRefReady = "true";

          // role=button rather than a real <button> so refs stay valid inside
          // links and other inline content produced by autoLinkBibleRefs.
          el.setAttribute("role", "button");
          el.setAttribute("tabindex", "0");
          el.setAttribute("aria-expanded", "false");

          el.addEventListener("mouseenter", () => {
            if (!pinned) showTooltip(el);
          });
          el.addEventListener("mouseleave", () => {
            if (!pinned) hideTooltip();
          });
          el.addEventListener("focus", () => showTooltip(el));
          el.addEventListener("blur", () => {
            if (!pinned) hideTooltip();
          });

          el.addEventListener("click", (event) => {
            event.preventDefault();
            if (pinned && activeRef === el) {
              hideTooltip();
            } else {
              pinned = true;
              showTooltip(el);
            }
          });

          el.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              el.click();
            } else if (event.key === "Escape") {
              hideTooltip();
              el.blur();
            }
          });
        });
      }

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") hideTooltip();
      });

      document.addEventListener("click", (event) => {
        if (!pinned || !activeRef) return;
        if (!activeRef.contains(event.target) && !(tooltip && tooltip.contains(event.target))) {
          hideTooltip();
        }
      });

      window.addEventListener("resize", () => {
        if (activeRef) positionTooltip(activeRef);
      });

      initBibleRefs();
      document.addEventListener("astro:page-load", initBibleRefs);
    </script>
  </body>
</html>
