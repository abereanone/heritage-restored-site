---
// src/pages/resources.astro
import Layout from "../layouts/Layout.astro";
import ResourceList from "../components/ResourceList.jsx";
import FeaturedVideo from "../components/FeaturedVideo.astro";
import resources from "../data/resources.json";
---

<Layout
  title="Resources"
  description="A curated directory of abolitionist and Reformed ministries, teaching, books, and tools recommended by Heritage Restored."
>
  <article>
    <h1>Resources</h1>
    <p>
      Heritage Restored generally supports all the ministries listed here but may not be in complete
      agreement on everything that ministry stands for.
    </p>

    <ResourceList client:load resources={resources} />
    <FeaturedVideo />
    <p class="back-to-top"><a href="#top">↑ Back to top</a></p>
  </article>
</Layout>
