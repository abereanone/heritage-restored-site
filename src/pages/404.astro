---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found" description="The page you were looking for could not be found.">
  <article class="not-found-page">
    <p class="not-found-kicker">404</p>
    <h1>OOPS!</h1>
    <p>We could not find the page you were looking for.</p>
    <p><a class="home-link" href="/">Go to the home page</a></p>
  </article>
</Layout>

<style>
  .not-found-page {
    min-height: 45vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .not-found-kicker {
    margin-bottom: 0;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    opacity: 0.72;
  }

  .not-found-page h1 {
    margin: 0.2em 0;
    font-size: clamp(3rem, 8vw, 5rem);
  }

  .home-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 700;
  }
</style>
